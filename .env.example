# URL pública real do site no VPS, sem barra no final
SITE_URL=https://SEU-DOMINIO.com.br
# Opcional: permite redigir novos conteúdos originais quando a biblioteca editorial inicial acabar.
# A chave é privada; configure-a apenas no arquivo .env do VPS, nunca no GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=8080

# Opcional: gera ilustrações PNG com IA para quadrinhos/atividades. Pode gerar custos adicionais.
# Se ficar false, o sistema usa as ilustrações SVG originais como alternativa.
GENERATE_AI_IMAGES=false
